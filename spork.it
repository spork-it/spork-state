;; Spork Project Manifest
;; See https://github.com/spork-it/spork-lang/blob/main/docs/PROJECTS.md

{:name "spork-state"
 :version "0.2.1"
 :description "Thread-safe state management for Spork and Python"
 :requires-python ">=3.10"
 :spork-version ">=0.5.0,<0.6"
 :dependencies []
 :dev-dependencies ["mypy>=1.11"
                    "build>=1.2"
                    "twine>=5"]
 :source-paths ["src"]
 :test-paths ["tests"]
 :api {:from "spork-state.core"
       :spork {:namespace "spork-state"
               :exports ["Atom"
                         "validation-error-message"
                         "atom"
                         "atom?"
                         "deref"
                         "reset"
                         "reset!"
                         "reset-vals"
                         "reset-vals!"
                         "swap"
                         "swap!"
                         "swap-vals"
                         "swap-vals!"
                         "compare-and-set"
                         "compare-and-set!"
                         "add-watch"
                         "add-watch!"
                         "remove-watch"
                         "remove-watch!"
                         "subscribe"
                         "get-validator"
                         "set-validator"
                         "set-validator!"]}
       :python {:package "spork-state"
                :exports ["Atom"
                          "VALIDATION-ERROR-MESSAGE"
                          "atom"
                          "is-atom"
                          "deref"
                          "reset"
                          "reset-vals"
                          "swap"
                          "swap-vals"
                          "compare-and-set"
                          "add-watch"
                          "remove-watch"
                          "subscribe"
                          "get-validator"
                          "set-validator"]
                :version true
                :typed true}}
 :readme "README.md"
 :license "MIT"
 :license-file "LICENSE"
 :authors [{:name "Grant Wade" :email "grant@spork.sh"}]
 :keywords ["spork" "state" "atom" "concurrency" "lisp"]
 :classifiers ["Development Status :: 3 - Alpha"
               "Intended Audience :: Developers"
               "Operating System :: OS Independent"
               "Programming Language :: Lisp"
               "Programming Language :: Python :: 3"
               "Programming Language :: Python :: 3.10"
               "Programming Language :: Python :: 3.11"
               "Programming Language :: Python :: 3.12"
               "Programming Language :: Python :: 3.13"
               "Programming Language :: Python :: 3.14"
               "Typing :: Typed"]
 :urls {:Homepage "https://github.com/spork-it/spork-state"
        :Documentation "https://github.com/spork-it/spork-state#readme"
        :Repository "https://github.com/spork-it/spork-state"
        :Issues "https://github.com/spork-it/spork-state/issues"
        :Changelog "https://github.com/spork-it/spork-state/blob/main/CHANGELOG.md"}}
