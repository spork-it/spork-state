(ns spork-state.core-test
  (:require [spork-state.core :as state]))

(print "Testing spork-state Atom...")

(def reference (state.atom 0))
(assert (state.atom? reference))
(assert (= (state.deref reference) 0))
(assert (= reference.value 0))
(assert (= (repr reference) "Atom(0)"))

(assert (= (state.reset! reference 1) 1))
(assert (= (state.swap! reference (fn [value] (+ value 1))) 2))
(assert (= (state.swap! reference (fn [value amount] (+ value amount)) 3) 5))

(def reset-values (state.reset-vals! reference 8))
(assert (= (nth reset-values 0) 5))
(assert (= (nth reset-values 1) 8))

(def swap-values (state.swap-vals! reference (fn [value] (* value 2))))
(assert (= (nth swap-values 0) 8))
(assert (= (nth swap-values 1) 16))
(print "  basic updates passed")

;; Compare-and-set uses identity, not equality.
(def expected [1 2])
(def equal-but-distinct [1 2])
(def cas-reference (state.atom expected))
(assert (not (state.compare-and-set! cas-reference equal-but-distinct [3])))
(assert (is (state.deref cas-reference) expected))
(def replacement [3])
(assert (state.compare-and-set! cas-reference expected replacement))
(assert (is (state.deref cas-reference) replacement))
(print "  compare-and-set passed")

;; Validators reject before commit and can be replaced safely.
(def validator (fn [value] (>= value 0)))
(def validated (state.atom 1 validator))
(assert (is (state.get-validator validated) validator))
(def invalid-reset-rejected
  (try
    (state.reset! validated -1)
    false
    (catch ValueError error
      (= (str error) state.validation-error-message))))
(assert invalid-reset-rejected "invalid reset should throw")
(assert (= (state.deref validated) 1))

(def even-validator (fn [value] (= (% value 2) 0)))
(def invalid-validator-rejected
  (try
    (state.set-validator! validated even-validator)
    false
    (catch ValueError error
      (= (str error) state.validation-error-message))))
(assert invalid-validator-rejected "new validator must accept current value")
(assert (is (state.get-validator validated) validator))
(state.reset! validated 2)
(assert (is (state.set-validator! validated even-validator) validated))
(state.set-validator! validated nil)
(assert (is (state.get-validator validated) nil))
(print "  validators passed")

;; Watches run after commit, receive stable transition values, and are removable.
(def watched (state.atom 10))
(def events (list))
(defn record-watch [key watched-reference old-value new-value]
  (events.append [key (state.deref watched-reference) old-value new-value]))
(assert (is (state.add-watch! watched :audit record-watch) watched))
(state.reset! watched 11)
(assert (= (len events) 1))
(assert (= (nth (nth events 0) 0) :audit))
(assert (= (nth (nth events 0) 1) 11))
(assert (= (nth (nth events 0) 2) 10))
(assert (= (nth (nth events 0) 3) 11))
(assert (is (state.remove-watch! watched :audit) record-watch))
(state.reset! watched 12)
(assert (= (len events) 1))
(print "  keyed watches passed")

;; Recommitting the identical object is not a state transition.
(def marker (object))
(def identity-reference (state.atom marker))
(def identity-events (list))
(state.add-watch! identity-reference :identity
                  (fn [key ref old-value new-value]
                    (identity-events.append new-value)))
(state.reset! identity-reference marker)
(assert (= (len identity-events) 0))
(print "  identity notifications passed")

;; Watch failures never roll back an already committed value.
(def failing-watch-reference (state.atom 1))
(defn failing-watch [key ref old-value new-value]
  (throw (RuntimeError "watch failed")))
(state.add-watch! failing-watch-reference :failure failing-watch)
(def watch-failure-propagated
  (try
    (state.reset! failing-watch-reference 2)
    false
    (catch RuntimeError error
      (= (str error) "watch failed"))))
(assert watch-failure-propagated "watch failure should propagate")
(assert (= (state.deref failing-watch-reference) 2))
(print "  watch failures passed")

;; Subscriptions provide a smaller Python-friendly callback shape.
(def subscribed (state.atom "ready"))
(def subscription-events (list))
(def unsubscribe
  (state.subscribe subscribed
                   (fn [old-value new-value]
                     (subscription-events.append [old-value new-value]))
                   *{:fire-immediately true}))
(state.reset! subscribed "running")
(unsubscribe)
(unsubscribe)
(state.reset! subscribed "done")
(assert (= (len subscription-events) 2))
(assert (= (nth (nth subscription-events 0) 0) "ready"))
(assert (= (nth (nth subscription-events 0) 1) "ready"))
(assert (= (nth (nth subscription-events 1) 0) "ready"))
(assert (= (nth (nth subscription-events 1) 1) "running"))

(print "All spork-state Atom tests passed!")
